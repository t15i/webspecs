{
  "name": "@t15i/webspecs",
  "type": "module",
  "version": "0.5.0",
  "description": "TypeScript implementations of web platform specifications",
  "keywords": [
    "ecma",
    "dom",
    "html",
    "infra",
    "url",
    "webidl",
    "whatwg",
    "w3c",
    "specifications"
  ],
  "author": "Aleksandr Boiarnikov <dev@gmvr.pw> (https://gmvr.pw)",
  "license": "MIT",
  "homepage": "https://github.com/t15i/webspecs#README",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/t15i/webspecs.git"
  },
  "bugs": {
    "url": "https://github.com/t15i/webspecs/issues"
  },
  "exports": {
    "./dom": {
      "types": "./dist/types/dom/index.d.ts",
      "import": "./dist/lib/dom/index.js"
    },
    "./ecma": {
      "types": "./dist/types/ecma/index.d.ts",
      "import": "./dist/lib/ecma/index.js"
    },
    "./html": {
      "types": "./dist/types/html/index.d.ts",
      "import": "./dist/lib/html/index.js"
    },
    "./infra": {
      "types": "./dist/types/infra/index.d.ts",
      "import": "./dist/lib/infra/index.js"
    },
    "./share": {
      "types": "./dist/types/share/index.d.ts",
      "import": "./dist/lib/share/index.js"
    },
    "./url": {
      "types": "./dist/types/url/index.d.ts",
      "import": "./dist/lib/url/index.js"
    },
    "./webidl": {
      "types": "./dist/types/webidl/index.d.ts",
      "import": "./dist/lib/webidl/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "lint": "eslint lib test",
    "format": "prettier --check --write lib test",
    "typecheck": "tsc -p lib/tsconfig.json && tsc -p test/tsconfig.json",
    "test": "vitest watch",
    "build": "vite build",
    "ci:lint": "eslint --max-warnings 1 lib test",
    "ci:lint:lib": "eslint --max-warnings 1 lib",
    "ci:lint:tests": "eslint --max-warnings 1 test",
    "ci:format": "prettier --list-different lib test",
    "ci:format:lib": "prettier --list-different lib",
    "ci:format:tests": "prettier --list-different tests",
    "ci:typecheck": "npm run ci:typecheck:lib && npm run ci:typecheck:tests",
    "ci:typecheck:lib": "tsc -p lib/tsconfig.json",
    "ci:typecheck:tests": "tsc -p test/tsconfig.json",
    "ci:test": "npx playwright install && vitest run --browser.headless",
    "ci:build": "vite build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-istanbul": "^4.1.4",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-tsdoc": "^0.5.2",
    "playwright": "^1.59.1",
    "prettier": "^3.8.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.0.8",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
